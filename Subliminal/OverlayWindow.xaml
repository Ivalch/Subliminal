<Window x:Class="Subliminal.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Subliminal.Converters"
        Title="Subliminal Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush" />
        <conv:PercentToOpacityConverter x:Key="PercentToOpacity" />
    </Window.Resources>

    <!--
      Opacity applies to the text only; the window background stays fully transparent.
      PercentToOpacityConverter treats Transparency as a real transparency percentage,
      so 95 means 95% transparent (5% opaque) and 0 means fully opaque.
    -->
    <Border Opacity="{Binding Transparency, Converter={StaticResource PercentToOpacity}}">
        <TextBlock Text="{Binding DisplayText}"
                   Foreground="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                   FontSize="54"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="24"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
    </Border>
</Window>
