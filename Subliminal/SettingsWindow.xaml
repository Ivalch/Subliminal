<Window x:Class="Subliminal.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Subliminal Settings"
        Icon="pack://application:,,,/Subliminal.ico"
        Width="380"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="16">
        <CheckBox Content="Start with Windows"
                  IsChecked="{Binding StartWithWindows}"
                  Margin="0,4" />
        <CheckBox Content="Show tray notifications"
                  IsChecked="{Binding ShowTrayNotifications}"
                  Margin="0,4" />

        <Separator Margin="0,12" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Close"
                    Width="88"
                    Margin="0,0,8,0"
                    Click="OnCloseClick" />
            <Button Content="Save"
                    Width="88"
                    IsDefault="True"
                    Click="OnSaveClick" />
        </StackPanel>
    </StackPanel>
</Window>
