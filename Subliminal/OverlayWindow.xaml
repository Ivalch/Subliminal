<Window x:Class="Subliminal.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Subliminal.Converters"
        Title="Subliminal Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush" />
    </Window.Resources>

    <!--
      Opacity is driven by the appear/show/fade cycle in the ViewModel, not by the
      transparency setting directly, so the ramps can be animated. The window background
      stays fully transparent; only the text is affected.
    -->
    <Border Opacity="{Binding CurrentOpacity}">
        <TextBlock Text="{Binding DisplayText}"
                   Foreground="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                   FontSize="54"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="24"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
    </Border>
</Window>
